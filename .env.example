# Copier ce fichier en .env et remplir les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Identifiants de l'espace admin.
# Le hash se génère avec : node backend/hash-motdepasse.js "votre-mot-de-passe"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# En production (Railway) : dossier du volume persistant.
# DATA_DIR=/data

# Notification par email au cabinet à chaque nouveau RDV/message (resend.com).
# Sans cette clé, les emails ne sont simplement pas envoyés.
RESEND_API_KEY=
# Optionnel : adresse d'expédition (par défaut onboarding@resend.dev).
# RESEND_FROM_EMAIL=Cabinet Dentaire <onboarding@resend.dev>
