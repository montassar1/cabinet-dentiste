# Copier ce fichier en .env et remplir les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Identifiants de l'espace admin.
# Le hash se génère avec : node backend/hash-motdepasse.js "votre-mot-de-passe"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# En production (Railway) : dossier du volume persistant.
# DATA_DIR=/data
