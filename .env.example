# Copier ce fichier en .env et remplir les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Identifiants de l'espace admin.
# Le hash se génère avec : node backend/hash-motdepasse.js "votre-mot-de-passe"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# En production (Railway) : dossier du volume persistant.
# DATA_DIR=/data

# Emails (resend.com) : notification au cabinet à chaque RDV/message,
# et confirmation envoyée au patient après sa réservation.
# Sans cette clé, les emails ne sont simplement pas envoyés.
RESEND_API_KEY=
# Adresse d'expédition. Par défaut onboarding@resend.dev, qui ne peut
# écrire QU'À l'adresse du compte Resend : pour que les patients reçoivent
# leur confirmation, vérifier le domaine dentaliege.be dans Resend
# (Domains) puis utiliser une adresse de ce domaine, ex. :
# RESEND_FROM_EMAIL=Dentaliège <rendez-vous@dentaliege.be>
